@model UsuariosViewModel
@{
    Layout = "_LayoutAntigo";
    ViewData["Title"] = "Usuários";
    ViewData["Pagina"] = "usuarios";
}

<div class="barra">
    <h1>Usuários</h1>
    <a class="btn" asp-controller="Cadastro" asp-action="Index">+ Novo MEI</a>
</div>

<form method="get" class="busca" asp-controller="Usuarios" asp-action="Index">
    <input type="search" name="nome" value="@Model.Busca" placeholder="Buscar por nome...">
    <button type="submit" class="btn btn--claro">Buscar</button>
    @if (Model.Busca != "")
    {
        <a class="btn btn--link" asp-controller="Usuarios" asp-action="Index">Limpar</a>
    }
</form>

@if (!string.IsNullOrEmpty(Model.ErroApi))
{
    <div class="alerta alerta--erro"><span>@Model.ErroApi</span></div>
}

<div class="tabela-wrap">
    <table class="tabela">
        <thead>
            <tr>
                <th style="width: 90px">ID</th>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Cidade</th>
                <th>Plano</th>
                <th style="width: 190px">Ações</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Usuarios.Count == 0)
        {
            <tr><td colspan="6" class="tabela__vazio">Nenhum usuário encontrado.</td></tr>
        }
        else
        {
            foreach (var u in Model.Usuarios)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.Nome</td>
                    <td>@u.Email</td>
                    <td>@(string.IsNullOrEmpty(u.Estado) ? u.Cidade : $"{u.Cidade} - {u.Estado}")</td>
                    <td>@(u.Plano == "premium" ? "Premium" : "Gratuito")</td>
                    <td class="tabela__acoes">
                        <button type="button" class="btn btn--pequeno btn--claro"
                                data-modal-abrir="modal-usuario" data-acao="editar"
                                data-id="@u.Id" data-nome="@u.Nome">Editar</button>
                        <button type="button" class="btn btn--pequeno btn--perigo"
                                data-modal-abrir="modal-confirmar" data-acao="excluir"
                                data-id="@u.Id" data-nome="@u.Nome">Excluir</button>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<partial name="_ModalUsuario" />
<partial name="_ModalConfirmar" />

@section Scripts {
    <script src="~/js/Usuario.js"></script>
}
